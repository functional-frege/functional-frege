import Frege.OpenLambdaSyntax
import Frege.Reduction
import Frege.CombinatoryAlgebra

/-!
# Constructing the extensional open lambda-term algebra

The carrier is an actual quotient of open pure terms. Its equality is the
substitutive congruence generated by beta and eta. Extensionality is proved
by choosing a fresh free variable and abstracting it; it is not an axiom of
the equality relation or a hypothesis on a supplied algebra.

`BetaEtaConversion.lean` proves correspondence with beta-eta reduction.
`BetaEtaSeparation.lean` and `TermAlgebraCountability.lean` prove that this
same algebra is nontrivial and countably infinite. The construction is the
starting algebra; it does not yet supply the full PE-lambda model.
-/

namespace Frege.OpenLambda

/-- The equational presentation of beta-eta conversion, with explicit substitution. -/
inductive Equality : {n : Nat} → Term n → Term n → Prop where
  | refl (term : Term n) : Equality term term
  | symm : Equality left right → Equality right left
  | trans : Equality left middle → Equality middle right → Equality left right
  | app : Equality left right → Equality argument other →
      Equality (.app left argument) (.app right other)
  | lam : Equality body other → Equality (.lam body) (.lam other)
  | beta (body : Term (n + 1)) (argument : Term n) :
      Equality (.app (.lam body) argument) (Program.beta body argument)
  | eta (term : Term n) :
      Equality (.lam (.app (Program.rename Fin.succ term) (.var 0))) term
  | instantiate (bound : Fin n → Term m) (free : Nat → Term m) :
      Equality left right → Equality (OpenLambda.instantiate bound free left)
        (OpenLambda.instantiate bound free right)

namespace Equality

/-- Every operational beta step is an equation of the open calculus. -/
theorem ofStep (step : Program.Step left right) : Equality left right := by
  induction step with
  | beta body argument => exact .beta body argument
  | left _ proof => exact .app proof (.refl _)
  | right _ proof => exact .app (.refl _) proof
  | underLam _ proof => exact .lam proof

theorem ofSteps (steps : Program.Steps left right) : Equality left right := by
  induction steps with
  | refl term => exact .refl term
  | next step _ rest => exact .trans (ofStep step) rest

end Equality

def equalitySetoid (n : Nat) : Setoid (Term n) where
  r := Equality
  iseqv := ⟨Equality.refl, Equality.symm, Equality.trans⟩

/-- Algebra elements may contain arbitrary free names, but no unbound local indices. -/
def Element := Quotient (equalitySetoid 0)

def termClass (term : Term 0) : Element := Quotient.mk _ term

def apply (left right : Element) : Element :=
  Quotient.liftOn₂ left right (fun first second => termClass (.app first second))
    (by
      intro first second otherFirst otherSecond sameFirst sameSecond
      exact Quotient.sound (.app sameFirst sameSecond))

/-- The two ordinary closed combinator terms. -/
def constantTerm : Term 0 := .lam (.lam (.var 1))

def distributionTerm : Term 0 :=
  .lam (.lam (.lam (.app (.app (.var 2) (.var 0)) (.app (.var 1) (.var 0)))))

theorem the_constant_term_reduces_on_symbolic_arguments :
    Equality (.app (.app constantTerm (.coeff 0)) (.coeff 1)) (.coeff 0) := by
  exact Equality.ofSteps (Program.execute 2 (.app (.app constantTerm (.coeff 0)) (.coeff 1))).property

theorem the_distribution_term_reduces_on_symbolic_arguments :
    Equality (.app (.app (.app distributionTerm (.coeff 0)) (.coeff 1)) (.coeff 2))
      (.app (.app (.coeff 0) (.coeff 2)) (.app (.coeff 1) (.coeff 2))) := by
  exact Equality.ofSteps
    (Program.execute 3 (.app (.app (.app distributionTerm (.coeff 0)) (.coeff 1)) (.coeff 2))).property

/-- Substitute arbitrary open arguments into the checked symbolic computation. -/
theorem the_constant_term_returns_its_first_argument (first second : Term 0) :
    Equality (.app (.app constantTerm first) second) first := by
  let replace : Nat → Term 0 := fun name =>
    if name = 0 then first else if name = 1 then second else .coeff name
  have equation := Equality.instantiate Fin.elim0 replace
    the_constant_term_reduces_on_symbolic_arguments
  exact equation

theorem the_distribution_term_applies_the_same_argument (left right argument : Term 0) :
    Equality (.app (.app (.app distributionTerm left) right) argument)
      (.app (.app left argument) (.app right argument)) := by
  let replace : Nat → Term 0 := fun name =>
    if name = 0 then left else if name = 1 then right else if name = 2 then argument else .coeff name
  have equation := Equality.instantiate Fin.elim0 replace
    the_distribution_term_reduces_on_symbolic_arguments
  exact equation

/-- A concrete total combinatory algebra, constructed from syntax and its quotient. -/
def algebra : CombinatoryAlgebra Element where
  apply := apply
  constant := termClass constantTerm
  distribute := termClass distributionTerm
  constant_returns_first_argument := by
    intro first second
    refine Quotient.inductionOn₂ first second ?_
    intro firstTerm secondTerm
    exact Quotient.sound (the_constant_term_returns_its_first_argument firstTerm secondTerm)
  distribute_applies_the_same_argument := by
    intro left right argument
    refine Quotient.inductionOn₃ left right argument ?_
    intro leftTerm rightTerm argumentTerm
    exact Quotient.sound (the_distribution_term_applies_the_same_argument leftTerm rightTerm argumentTerm)

/-- All-input agreement implies equality in the constructed open-term algebra.

For representatives M and N choose a free name absent from both. Agreement
at that variable gives M z = N z. Instantiation turns z into a fresh bound
variable, lambda congruence abstracts it, and eta yields M = N. This proof
uses the available open terms; it does not assume extensionality as a rule.
-/
theorem the_constructed_open_term_algebra_is_extensional : algebra.IsExtensional := by
  intro left right
  refine Quotient.inductionOn₂ left right ?_
  intro first second agree
  let name := max (freshBound first) (freshBound second)
  have freshFirst : name ∉ freeNames first :=
    any_name_at_or_above_the_bound_is_fresh first name (Nat.le_max_left _ _)
  have freshSecond : name ∉ freeNames second :=
    any_name_at_or_above_the_bound_is_fresh second name (Nat.le_max_right _ _)
  have atName : Equality (.app first (.coeff name)) (.app second (.coeff name)) :=
    Quotient.exact (agree (termClass (.coeff name)))
  have instantiated := Equality.instantiate (m := 1) Fin.elim0
    (fun other => if other = name then .var 0 else .coeff other) atName
  have bodiesAgree : Equality (.app (bindFreeName name first) (.var 0))
      (.app (bindFreeName name second) (.var 0)) := by
    simpa only [bindFreeName, instantiate, if_pos rfl, ite_true] using instantiated
  rw [binding_a_fresh_name_only_weakens_the_term first name freshFirst,
      binding_a_fresh_name_only_weakens_the_term second name freshSecond] at bodiesAgree
  exact Quotient.sound ((Equality.eta first).symm.trans
    ((Equality.lam bodiesAgree).trans (Equality.eta second)))

end Frege.OpenLambda
